# ---------- Safety ----------
# Bot never places real bets unless BOTH are set.
LIVE=false
I_UNDERSTAND_THIS_BETS_REAL_MONEY=false
# Trade on fuzzy (automatic) event matches too, not just mappings.json. Risky.
AUTO_MATCH_TRADE=false

# ---------- Bankroll / risk ----------
BANKROLL_USD=1000            # used for Kelly sizing
KELLY_FRACTION=0.25          # fraction of full Kelly
MAX_STAKE_USD=50             # hard cap per bet
MIN_STAKE_USD=2              # skip anything smaller (Betfair min is ~2 GBP)
MAX_DAILY_EXPOSURE_USD=300   # sum of stakes placed in a UTC day
MIN_EDGE=0.04                # value bet: fair prob - price must exceed this (4 pts)
MIN_ARB_MARGIN=0.01          # cross-venue arb: sell - buy must exceed this (1 pt)
MIN_LIQUIDITY_USD=20         # book depth needed at the price we want
COOLDOWN_MIN=180             # don't re-bet the same market/outcome within this window
MATCH_THRESHOLD=0.62         # fuzzy match similarity 0..1
GBP_USD=1.27                 # Betfair stakes are in account currency; rough FX for sizing
FAIR_WEIGHT_BF=0.7           # weight of Betfair mid vs Polymarket mid when estimating "fair" prob

# ---------- Polymarket ----------
PM_FEE=0.0                   # taker fee as a fraction of notional (most markets 0)
PM_MAX_MARKETS=300
# Needed only for LIVE Polymarket orders (npm i @polymarket/clob-client ethers)
PM_PRIVATE_KEY=
PM_FUNDER=                   # proxy/safe wallet address shown in Polymarket UI
PM_SIGNATURE_TYPE=1          # 0=EOA, 1=Magic/email proxy, 2=Gnosis safe

# ---------- Betfair ----------
BF_APP_KEY=
BF_USERNAME=
BF_PASSWORD=
# Or supply a ready session token instead of username/password:
BF_SESSION_TOKEN=
BF_COMMISSION=0.05
BF_EVENT_TYPES=Politics,Soccer,Tennis,Basketball,American Football,Special Bets
BF_MAX_MARKETS=400
